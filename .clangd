# clangd 配置（S1 引入）：
# 1. CompilationDatabase 指向 CMake 生成的 build/compile_commands.json（首选）
# 2. Add 兜底 include 路径——即使数据库缺失也能找到 common/protocol.hpp
CompileFlags:
  CompilationDatabase: build
  Add: [-I/root/project/yxAgent/src]

# InlayHints（行内提示）：
#   ParameterNames: No —— 调用处不再显示参数名/参数类型灰字
#   DeducedTypes:   No —— auto 变量不再显示推导类型灰字
# 想彻底关掉所有行内提示：把下面 Enabled 改成 No
# 想只开其中一样：删掉对应行或改回 Yes
InlayHints:
  Enabled: Yes
  ParameterNames: No
  DeducedTypes: No

# 注意：本文件含服务器绝对路径，本地 Windows 镜像需改成 -IC:/Users/Administrator/Desktop/agents/yxAgent/src
